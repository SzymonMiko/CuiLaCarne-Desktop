<Window
    x:Class="QuiLaCarne.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="QuiLaCarne"
    Height="720"
    Width="1200"
    MinHeight="600"
    MinWidth="900"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            x:Name="ShellNavigationBar"
            Grid.Row="0"
            Background="#222222">
            <DockPanel LastChildFill="False">
                <Button
                    x:Name="BackToMenuButton"
                    Content="Menu"
                    Width="96"
                    Height="32"
                    Margin="12 0"
                    VerticalAlignment="Center"
                    Background="#19A93A"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="BackToMenuButton_Click"/>

                <TextBlock
                    x:Name="ShellTitle"
                    DockPanel.Dock="Right"
                    Margin="0 0 18 0"
                    VerticalAlignment="Center"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <Frame
            x:Name="MainFrame"
            Grid.Row="1"
            NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
