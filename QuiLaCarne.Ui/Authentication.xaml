<Window
    x:Class="QuiLaCarne.Ui.Authentication"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Two Factor Authentication"
    Width="1200"
    Height="720"
    WindowStartupLocation="CenterScreen"
    Background="#111111">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#0B6B2D">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24 0">
                <TextBlock Text="🍕" FontSize="20" Margin="0 0 10 0"/>
                <TextBlock Text="Qui la Carne" FontSize="20" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2B1208" Offset="0"/>
                    <GradientStop Color="#141414" Offset="0.6"/>
                    <GradientStop Color="#06330F" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Rectangle Fill="#66000000"/>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="460">

                <TextBlock Text="Qui la Carne"
                           FontFamily="Segoe Script"
                           FontSize="58"
                           Foreground="#FF2D2D"
                           TextAlignment="Center"/>

                <TextBlock Text="Weryfikacja dwuetapowa"
                           Foreground="White"
                           FontSize="20"
                           Margin="0 12 0 28"
                           TextAlignment="Center"/>

                <Border Background="#EFFFFFFF"
                        CornerRadius="12"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Wpisz kod z aplikacji authenticator"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 8"/>

                        <TextBox Height="42"
                                 FontSize="18"
                                 TextAlignment="Center"
                                 MaxLength="6"
                                 Text="{Binding TwoFactorCode,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Verify"
                                Margin="0 12 0 0"
                                Command="{Binding Verify2FaCommand}"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#B00000"
                                   TextAlignment="Center"
                                   Margin="0 14 0 0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
