<Window
    x:Class="QuiLaCarne.Ui.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Qui la Carne"
    Width="1200"
    Height="720"
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0 0 0 12"/>
            <Setter Property="Padding" Value="10 6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="InputPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0 0 0 18"/>
            <Setter Property="Padding" Value="10 6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18 6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#19A93A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#19A93A">
            <TextBlock Text="Qui la Carne"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="24 0"/>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right"
                        Margin="0 0 28 0"
                        VerticalAlignment="Center">
                <TextBlock Text="Manager"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Margin="0 0 24 0"/>
                <TextBlock Text="Kuchnia"
                           Foreground="White"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="440">

                <TextBlock FontSize="56"
                           FontWeight="Bold"
                           TextAlignment="Center">
                    <Run Text="Qui " Foreground="#E53935"/>
                    <Run Text="la Carne" Foreground="#1B9A2F"/>
                </TextBlock>

                <Grid Margin="0 8 0 24" Height="6" Width="300" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Fill="#19A93A" RadiusX="3" RadiusY="3"/>
                    <Rectangle Grid.Column="1" Fill="#E0E0E0" RadiusX="3" RadiusY="3"/>
                    <Rectangle Grid.Column="2" Fill="#E53935" RadiusX="3" RadiusY="3"/>
                </Grid>

                <TextBlock Text="Panel logowania personelu"
                           Foreground="#222222"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0 0 0 20"
                           TextAlignment="Center"/>

                <Border Background="White"
                        CornerRadius="22"
                        Padding="28">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16"
                                          ShadowDepth="3"
                                          Opacity="0.18"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Nazwa użytkownika / Email"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 6"/>

                        <TextBox Style="{StaticResource InputTextBoxStyle}"
                                 Text="{Binding Username,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Hasło"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 6"/>

                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource InputPasswordBoxStyle}"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                        <Button Content="Zaloguj"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding LoginCommand}"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#B00000"
                                   TextAlignment="Center"
                                   Margin="0 14 0 0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
