<Window
    x:Class="QuiLaCarne.Ui.Menu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Qui la Carne Panel"
    Width="1200"
    Height="720"
    WindowStartupLocation="CenterScreen"
    Background="#111111">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#0B6B2D">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="24 0">
                <TextBlock Text="🍕"
                           FontSize="20"
                           Margin="0 0 10 0"/>
                <TextBlock Text="Qui la Carne"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2B1208" Offset="0"/>
                    <GradientStop Color="#111111" Offset="0.55"/>
                    <GradientStop Color="#06330F" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Rectangle Fill="#66000000"/>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="720">

                <TextBlock Text="Qui la Carne"
                           FontFamily="Segoe Script"
                           FontSize="62"
                           Foreground="#FF2D2D"
                           TextAlignment="Center"/>

                <TextBlock Text="Wybierz panel roboczy"
                           Foreground="White"
                           FontSize="22"
                           Margin="0 12 0 34"
                           TextAlignment="Center"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#EFFFFFFF"
                            CornerRadius="14"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="Manager"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#0B6B2D"
                                       TextAlignment="Center"/>

                            <TextBlock Text="Zarządzanie menu, rezerwacjami i personelem"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0 14 0 20"/>

                            <Button Content="Otwórz panel managera"
                                    Command="{Binding OpenManagerCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#EFFFFFFF"
                            CornerRadius="14"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="Kitchen"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#0B6B2D"
                                       TextAlignment="Center"/>

                            <TextBlock Text="Zamówienia, statusy dań i obsługa kuchni"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0 14 0 20"/>

                            <Button Content="Otwórz panel kuchni"
                                    Command="{Binding OpenKitchenCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
