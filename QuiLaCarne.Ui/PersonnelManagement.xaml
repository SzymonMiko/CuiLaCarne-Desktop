<Page
  x:Class="QuiLaCarne.Ui.PersonnelManagement"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="PersonnelManagement"
  Loaded="Page_Loaded"
  Background="#F5F5F5">
  <Page.Resources>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#19A93A" />
      <Setter Property="Padding" Value="12 6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="#19A93A">
      <TextBlock Text="Qui la Carne" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="16 0" />
      <TextBlock Text="Personnel" DockPanel.Dock="Right" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 16 0" />
    </DockPanel>

    <Grid Grid.Row="1" Margin="16" MinWidth="820">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="500" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Margin="0 0 0 10">
            <TextBlock FontSize="28" FontWeight="Bold">
              <Run Text="Staff " Foreground="#E53935" />
              <Run Text="Accounts" Foreground="#1B9A2F" />
            </TextBlock>
            <TextBlock Text="Add employees, assign roles, and change availability." Foreground="#333333" FontSize="13" />
          </StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="34" FontSize="13" GridLinesVisibility="None">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" />
              <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
              <DataGridTextColumn Header="Roles" Binding="{Binding RolesText}" Width="*" />
              <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled}" Width="72" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12" />
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Employee Form" FontSize="20" FontWeight="Bold" Margin="0 0 0 10" />
          <TextBlock Text="Username" FontWeight="SemiBold" FontSize="12" />
          <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 8" />
          <TextBlock Text="Email" FontWeight="SemiBold" FontSize="12" />
          <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 8" />
          <TextBlock Text="Password" FontWeight="SemiBold" FontSize="12" />
          <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 8" />
          <TextBlock Text="Role" FontWeight="SemiBold" FontSize="12" />
          <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole}" Height="32" Margin="0 3 0 12" />
          <Button Content="Add employee" Command="{Binding AddEmployeeCommand}" Style="{StaticResource PrimaryButtonStyle}" />
          <Button Content="Change role" Command="{Binding ChangeRoleCommand}" Style="{StaticResource PrimaryButtonStyle}" Background="#19A93A" Margin="0 8 0 0" />
          <Button Content="Block / unblock" Command="{Binding ChangeAvailabilityCommand}" Style="{StaticResource PrimaryButtonStyle}" Background="#E53935" Margin="0 8 0 0" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
