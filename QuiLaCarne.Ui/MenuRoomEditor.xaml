<Page
  x:Class="QuiLaCarne.Ui.MenuRoomEditor"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="MenuRoomEditor"
  Background="#F5F5F5">
  <Page.Resources>
    <Style x:Key="ActionButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#19A93A" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12 6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TableCardButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="#19A93A">
      <TextBlock Text="Qui la Carne" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="16 0" />
      <TextBlock Text="Panel zarządzania" DockPanel.Dock="Right" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 16 0" />
    </DockPanel>

    <Grid Grid.Row="1" Margin="16" MinWidth="820">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.25*" MinWidth="430" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1*" MinWidth="340" />
      </Grid.ColumnDefinitions>

      <Border Background="White" CornerRadius="8" Padding="12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock FontSize="24" FontWeight="Bold" Margin="0 0 0 10">
            <Run Text="Edytor " Foreground="#E53935" />
            <Run Text="menu" Foreground="#1B9A2F" />
          </TextBlock>

          <DataGrid Grid.Row="1" ItemsSource="{Binding Dishes}" SelectedItem="{Binding SelectedDish}" AutoGenerateColumns="False" RowHeight="34" FontSize="13" GridLinesVisibility="None">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Danie" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="Cena" Binding="{Binding Price}" Width="78" />
              <DataGridCheckBoxColumn Header="Dostępne" Binding="{Binding IsAvailable}" Width="88" />
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Grid.Row="2" Margin="0 10 0 0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Cena" FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding EditedPrice, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Powód blokady" FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding BlockReason, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 0" />
              </StackPanel>
              <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Zapisz" Command="{Binding SavePriceCommand}" Style="{StaticResource ActionButtonStyle}" Width="84" />
                <Button Content="Zablokuj" Command="{Binding BlockDishCommand}" Style="{StaticResource ActionButtonStyle}" Width="84" Background="#E53935" Margin="8 0 0 0" />
                <Button Content="Dostępne" Command="{Binding MakeDishAvailableCommand}" Style="{StaticResource ActionButtonStyle}" Width="90" Background="#19A93A" Margin="8 0 0 0" />
                <Button Content="Usuń" Command="{Binding DeleteDishCommand}" Style="{StaticResource ActionButtonStyle}" Width="84" Background="#555555" Margin="8 0 0 0" />
              </StackPanel>
            </Grid>

            <Grid Margin="0 8 0 0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding SelectedDishPhotoName}" Foreground="#555" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Content="Wybierz zdjęcie" Command="{Binding SelectSelectedDishPhotoCommand}" Style="{StaticResource ActionButtonStyle}" Width="126" Background="#555555" />
              <Button Grid.Column="4" Content="Zmień zdjęcie" Command="{Binding ChangeSelectedDishPhotoCommand}" Style="{StaticResource ActionButtonStyle}" Width="116" Background="#555555" />
            </Grid>

            <Border Height="1" Background="#E6E6E6" Margin="0 12 0 10" />

            <TextBlock Text="Dodaj składnik" FontWeight="Bold" FontSize="13" Margin="0 0 0 6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Nazwa PL" FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding NewIngredientNamePl, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Nazwa EN" FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding NewIngredientNameEn, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 0" />
              </StackPanel>
              <Button Grid.Column="4" Content="Dodaj składnik" Command="{Binding AddIngredientCommand}" Style="{StaticResource ActionButtonStyle}" Width="124" VerticalAlignment="Bottom" />
            </Grid>
            <Grid Margin="0 8 0 0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Alergeny" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Top" Margin="0 4 0 0" />
              <ListBox Grid.Column="2" ItemsSource="{Binding AllergensForIngredient}" Height="58" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <TextBlock Text="Dodaj danie" FontWeight="Bold" FontSize="13" Margin="0 12 0 6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Nazwa dania" FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding NewDishName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Cena" FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding NewDishPrice, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 0" />
              </StackPanel>
              <StackPanel Grid.Column="4">
                <TextBlock Text="Kategoria" FontWeight="SemiBold" FontSize="12" />
                <ComboBox ItemsSource="{Binding DishCategories}" SelectedItem="{Binding SelectedDishCategory}" DisplayMemberPath="Name" Height="32" Margin="0 3 0 0" />
              </StackPanel>
            </Grid>

            <Grid Margin="0 8 0 0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding NewDishPhotoName}" Foreground="#555" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="2" Content="Wybierz zdjęcie" Command="{Binding SelectDishPhotoCommand}" Style="{StaticResource ActionButtonStyle}" Width="126" />
            </Grid>

            <Grid Margin="0 8 0 0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ListBox ItemsSource="{Binding IngredientsForDish}" Height="82" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="2" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Column="2" Content="Dodaj danie" Command="{Binding AddDishCommand}" Style="{StaticResource ActionButtonStyle}" Width="104" VerticalAlignment="Bottom" />
            </Grid>

            <Border Height="1" Background="#E6E6E6" Margin="0 12 0 10" />

            <TextBlock Text="Usuń słownik" FontWeight="Bold" FontSize="13" Margin="0 0 0 6" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding DeleteTargetTypes}" SelectedItem="{Binding SelectedDeleteTargetType}" DisplayMemberPath="Name" Height="32" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding DeleteLookupItems}" SelectedItem="{Binding SelectedDeleteLookupItem}" DisplayMemberPath="Name" Height="32" />
              <Button Grid.Column="4" Content="Usuń" Command="{Binding DeleteLookupCommand}" Style="{StaticResource ActionButtonStyle}" Width="84" Background="#555555" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.1*" />
            <RowDefinition Height="220" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock FontSize="24" FontWeight="Bold" Margin="0 0 0 10">
            <Run Text="Mapa " Foreground="#E53935" />
            <Run Text="sali" Foreground="#1B9A2F" />
          </TextBlock>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tables}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Style="{StaticResource TableCardButtonStyle}">
                    <Border Width="118" Height="92" CornerRadius="8" Background="{Binding CardBackground}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="{Binding CardBorderThickness}" Padding="8">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TableNumber, StringFormat=Stolik {0}}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="13" />
                        <TextBlock Text="{Binding Capacity, StringFormat={}{0} miejsc}" Foreground="#555" HorizontalAlignment="Center" FontSize="12" Margin="0 1 0 5" />
                        <Border Background="{Binding StatusBadgeBackground}" CornerRadius="5" Padding="6 2" MaxWidth="98">
                          <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBadgeForeground}" FontWeight="SemiBold" HorizontalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </Border>
                      </StackPanel>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Border Grid.Row="2" Background="#F8F8F8" CornerRadius="8" Padding="10" Margin="0 10 0 0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedTable.TableNumber, StringFormat=Stolik {0}, TargetNullValue=Wybierz stolik}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Usuń stolik" Command="{Binding DeleteSelectedTableCommand}" Style="{StaticResource ActionButtonStyle}" Background="#555555" Height="28" Padding="10 4" />
              </Grid>
              <TextBlock Grid.Row="2" Text="{Binding SelectedTable.StatusText, StringFormat=Status: {0}, TargetNullValue=Status: -}" Foreground="#555" FontSize="12" />
              <TextBlock Grid.Row="4" Text="{Binding SelectedTableOrdersText}" Foreground="#555" FontSize="12" />

              <DataGrid
                Grid.Row="6"
                ItemsSource="{Binding SelectedTableOrders}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                RowHeight="30"
                FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Czas" Binding="{Binding CreatedAtText}" Width="112" />
                  <DataGridTextColumn Header="Gość" Binding="{Binding Guest}" Width="80" />
                  <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90" />
                  <DataGridTextColumn Header="Dania" Binding="{Binding DishesText}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>

          <Border Grid.Row="3" Background="#F8F8F8" CornerRadius="8" Padding="10" Margin="0 10 0 0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Text="Stolik" FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding NewTableNumber, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 0" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Miejsca" FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding NewTableCapacity, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0 3 0 0" />
              </StackPanel>
              <Button Grid.Column="4" Content="Dodaj stolik" Command="{Binding AddTableCommand}" Width="104" Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Bottom" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
