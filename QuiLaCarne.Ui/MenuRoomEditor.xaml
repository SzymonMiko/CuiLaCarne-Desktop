<Page x:Class="QuiLaCarne.Ui.MenuRoomEditor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MenuRoomEditor"
      Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="#19A93A">
            <TextBlock Text="Qui la Carne" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="24 0"/>
            <TextBlock Text="Menu &amp; Room Editor" DockPanel.Dock="Right" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 24 0"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="24" MinWidth="860">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="450"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="1*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="22" Padding="18">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock FontSize="36" FontWeight="Bold" Margin="0 0 0 12"><Run Text="Menu " Foreground="#E53935"/><Run Text="edition" Foreground="#1B9A2F"/></TextBlock>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Dishes}" SelectedItem="{Binding SelectedDish}" AutoGenerateColumns="False" RowHeight="40" GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dish" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Available" Binding="{Binding IsAvailable}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Margin="0 14 0 0">
                        <TextBlock Text="Selected dish price" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding EditedPrice, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0 4 0 10"/>
                        <TextBlock Text="Block reason" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding BlockReason, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0 4 0 10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Save price" Command="{Binding SavePriceCommand}" Width="130" Height="40" Background="#19A93A" Foreground="White" BorderThickness="0"/>
                            <Button Content="Block dish" Command="{Binding BlockDishCommand}" Width="130" Height="40" Background="#E53935" Foreground="White" BorderThickness="0" Margin="10 0 0 0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="22" Padding="18">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock FontSize="36" FontWeight="Bold" Margin="0 0 0 12"><Run Text="Room " Foreground="#E53935"/><Run Text="map" Foreground="#1B9A2F"/></TextBlock>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tables}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="105" Height="85" CornerRadius="16" Background="#F5F5F5" BorderBrush="#19A93A" BorderThickness="2" Margin="8" Padding="10">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TableNumber, StringFormat=Table {0}}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Capacity, StringFormat={}{0} seats}" Foreground="#555" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 14 0 0">
                        <TextBox Text="{Binding NewTableNumber}" Width="85" Height="36" Margin="0 0 8 0"/>
                        <TextBox Text="{Binding NewTableCapacity}" Width="85" Height="36" Margin="0 0 8 0"/>
                        <Button Content="Add table" Command="{Binding AddTableCommand}" Width="115" Height="36" Background="#19A93A" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
