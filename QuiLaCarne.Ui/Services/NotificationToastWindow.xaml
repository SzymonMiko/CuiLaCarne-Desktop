<Window
    x:Class="QuiLaCarne.Ui.Services.NotificationToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="360"
    Height="104"
    WindowStyle="None"
    ResizeMode="NoResize"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True">

    <Border
        Margin="8"
        Padding="14 12"
        Background="#F8FAFC"
        BorderBrush="#CBD5E1"
        BorderThickness="1"
        CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                ShadowDepth="3"
                Direction="270"
                Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>

            <Border
                Width="28"
                Height="28"
                Background="#2563EB"
                CornerRadius="4"
                VerticalAlignment="Top">
                <TextBlock
                    Text="i"
                    Foreground="White"
                    FontSize="18"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock
                    x:Name="TitleText"
                    Foreground="#0F172A"
                    FontSize="14"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"/>

                <TextBlock
                    x:Name="MessageText"
                    Margin="0 5 0 0"
                    Foreground="#475569"
                    FontSize="12"
                    LineHeight="17"
                    TextWrapping="Wrap"
                    MaxHeight="38"/>

                <TextBlock
                    x:Name="TimeText"
                    Margin="0 6 0 0"
                    Foreground="#64748B"
                    FontSize="11"/>
            </StackPanel>

            <Button
                Grid.Column="2"
                Width="24"
                Height="24"
                Padding="0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#475569"
                FontSize="16"
                Content="x"
                Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
