<Page x:Class="QuiLaCarne.Ui.IngredientConfirmationPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="IngredientConfirmationPanel"
      Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="#19A93A">
            <TextBlock Text="Qui la Carne" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="24 0"/>
            <TextBlock Text="Ingredient Confirmation" DockPanel.Dock="Right" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 24 0"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="36">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="22" Padding="18">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="36" FontWeight="Bold"><Run Text="Missing " Foreground="#E53935"/><Run Text="ingredient" Foreground="#1B9A2F"/></TextBlock>
                    <TextBlock Text="Choose ingredient and confirm it is unavailable. Related dishes can be blocked and WebSocket will notify other clients." TextWrapping="Wrap" Foreground="#333" Margin="0 8 0 18"/>
                    <ListBox ItemsSource="{Binding Ingredients}" SelectedItem="{Binding SelectedIngredient}" DisplayMemberPath="Name" Height="300"/>
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Height="40" Margin="0 14 0 10"/>
                    <Button Content="Confirm missing ingredient" Command="{Binding ConfirmMissingIngredientCommand}" Height="42" Background="#E53935" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="22" Padding="18">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Affected dishes" FontSize="30" FontWeight="Bold" Margin="0 0 0 12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AffectedDishes}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="None" RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Dish" Binding="{Binding Name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Available" Binding="{Binding IsAvailable}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
