<Page
  x:Class="QuiLaCarne.Ui.ManagerTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="ManagerTab"
  Background="#F5F5F5">
  <Page.Resources>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#19A93A" />
      <Setter Property="Padding" Value="12 6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="#19A93A">
      <TextBlock Text="Qui la Carne" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="16 0" />
      <TextBlock Text="Menu Management" DockPanel.Dock="Right" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 16 0" />
    </DockPanel>

    <Grid Grid.Row="1" Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock FontSize="28" FontWeight="Bold">
          <Run Text="Menu " Foreground="#E53935" />
          <Run Text="Management" Foreground="#1B9A2F" />
        </TextBlock>
        <TextBlock Text="Block dishes, update availability, and wait for WebSocket confirmation." Foreground="#333333" FontSize="13" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12" />
        </Border.Effect>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <DataGrid
            ItemsSource="{Binding Dishes}"
            SelectedItem="{Binding SelectedDish}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            GridLinesVisibility="None"
            RowHeight="34"
            FontSize="13">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Dish" Binding="{Binding Name}" Width="*" />
              <DataGridCheckBoxColumn Header="Available" Binding="{Binding IsAvailable}" Width="92" />
              <DataGridTextColumn Header="Reason" Binding="{Binding UnavailableReason}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>

          <Border Grid.Column="2" Background="#FAFAFA" CornerRadius="8" Padding="12" BorderBrush="#E5E5E5" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="Selected Dish" FontSize="18" FontWeight="Bold" Foreground="#1B9A2F" Margin="0 0 0 10" />
              <Button Content="Block selected" Command="{Binding BlockSelectedDishCommand}" Style="{StaticResource PrimaryButtonStyle}" Background="#E53935" Margin="0 0 0 8" />
              <Button Content="Make available" Command="{Binding MakeSelectedDishAvailableCommand}" Style="{StaticResource PrimaryButtonStyle}" Background="#19A93A" Margin="0 0 0 8" />
              <Button Content="Refresh" Command="{Binding LoadDishesCommand}" Style="{StaticResource PrimaryButtonStyle}" Background="#333333" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
