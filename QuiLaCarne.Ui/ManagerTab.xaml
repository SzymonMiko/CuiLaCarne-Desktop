<Page x:Class="QuiLaCarne.Ui.ManagerTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:QuiLaCarne.Ui"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerTab">

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Background="#18A532"
            Grid.Row="0">

            <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="25,0">

                <TextBlock Text="Qui La Carne"
                       FontWeight="Bold"
                       FontSize="22"
                       Foreground="White"
                       Margin="0,0,30,0"/>

                <TextBlock Text="Manager"
                       Foreground="White"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1">

            <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="850">

                <!-- TITLE -->
                <TextBlock Text="Manager Panel"
                       FontSize="34"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>

                <!-- CARD -->
                <Border Background="White"
                    CornerRadius="18"
                    Padding="25">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="2"
                                      Opacity="0.15"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DISH GRID -->
                        <DataGrid Grid.Row="0"
                              ItemsSource="{Binding Dishes}"
                              SelectedItem="{Binding SelectedDish}"
                              AutoGenerateColumns="False"
                              MinHeight="300"
                              BorderThickness="0"
                              FontSize="14"
                              RowHeight="40">

                            <DataGrid.Columns>

                                <DataGridTextColumn
                                Header="Dish name"
                                Binding="{Binding Name}"
                                Width="*"/>

                                <DataGridCheckBoxColumn
                                Header="Available"
                                Binding="{Binding IsAvailable}"
                                Width="120"/>

                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,25,0,0">

                            <TextBox Width="280"
                                 Height="40"
                                 Text="{Binding UnavailableReason}"
                                 Margin="0,0,15,0"/>

                            <Button Content="Load dishes"
                                Width="150"
                                Height="42"
                                Margin="0,0,10,0"
                                Command="{Binding LoadDishesCommand}"
                                Background="#18A532"
                                Foreground="White"
                                BorderThickness="0"/>

                            <Button Content="Toggle availability"
                                Width="190"
                                Height="42"
                                Command="{Binding ToggleAvailabilityCommand}"
                                Background="#D32F2F"
                                Foreground="White"
                                BorderThickness="0"/>
                        </StackPanel>

                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </Grid>
</Page>
