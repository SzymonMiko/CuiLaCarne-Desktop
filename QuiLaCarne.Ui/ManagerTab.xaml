<Page
  x:Class="QuiLaCarne.Ui.ManagerTab"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="ManagerTab"
  Background="#F5F5F5"
>
  <Page.Resources>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#19A93A" />
      <Setter Property="Padding" Value="18 8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="20">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="#19A93A">
      <TextBlock
        Text="Qui la Carne"
        Foreground="White"
        FontSize="22"
        FontWeight="Bold"
        VerticalAlignment="Center"
        Margin="24 0"
      />
      <TextBlock
        Text="Zarządzanie Menu"
        DockPanel.Dock="Right"
        Foreground="White"
        FontSize="16"
        FontWeight="SemiBold"
        VerticalAlignment="Center"
        Margin="0 0 24 0"
      />
    </DockPanel>

    <Grid Grid.Row="1" Margin="36">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock FontSize="46" FontWeight="Bold">
          <Run Text="Menu " Foreground="#E53935" />
          <Run Text="Management" Foreground="#1B9A2F" />
        </TextBlock>

        <Grid Margin="0 8 0 18" Height="6" Width="420" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
          </Grid.ColumnDefinitions>
          <Rectangle Fill="#19A93A" RadiusX="3" RadiusY="3" />
          <Rectangle Grid.Column="1" Fill="#E0E0E0" RadiusX="3" RadiusY="3" />
          <Rectangle Grid.Column="2" Fill="#E53935" RadiusX="3" RadiusY="3" />
        </Grid>

        <TextBlock
          Text="Blokowanie potraw z obowiązkowym powodem. Zmiana idzie do backendu, a WebSocket rozsyła aktualizację do reszty systemu."
          Foreground="#333333"
          FontSize="16"
          TextWrapping="Wrap"
        />
      </StackPanel>

      <Border Grid.Row="2" Background="White" CornerRadius="22" Padding="18">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" />
        </Border.Effect>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>

          <DataGrid
            ItemsSource="{Binding Dishes}"
            SelectedItem="{Binding SelectedDish}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            GridLinesVisibility="None"
            RowHeight="42"
            FontSize="14"
          >
            <DataGrid.Columns>
              <DataGridTextColumn Header="Dish name" Binding="{Binding Name}" Width="*" />
              <DataGridCheckBoxColumn
                Header="Available"
                Binding="{Binding IsAvailable}"
                Width="120"
              />
              <DataGridTextColumn
                Header="Reason"
                Binding="{Binding UnavailableReason}"
                Width="2*"
              />
            </DataGrid.Columns>
          </DataGrid>

          <Border
            Grid.Column="2"
            Background="#FAFAFA"
            CornerRadius="18"
            Padding="18"
            BorderBrush="#EEEEEE"
            BorderThickness="1"
          >
            <StackPanel>
              <TextBlock
                Text="Selected dish"
                FontSize="22"
                FontWeight="Bold"
                Foreground="#1B9A2F"
              />


              <Button
                Content="Change availability"
                Command="{Binding ToggleAvailabilityCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Background="#E53935"
                Margin="0 18 0 8"
              />
              <Button
                Content="Refresh"
                Command="{Binding LoadDishesCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Margin="0 8 0 0"
                Background="#333333"
              />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
