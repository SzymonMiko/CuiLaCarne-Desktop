<Window x:Class="QuiLaCarne.Ui.KitchenMonitor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qui la Carne - KDS"
        Width="1200"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#19A93A"/>
            <Setter Property="Padding" Value="18 8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#19A93A">
            <TextBlock Text="Qui la Carne" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="24 0"/>
            <TextBlock Text="Kitchen Display System" DockPanel.Dock="Right" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 24 0"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="46" FontWeight="Bold">
                    <Run Text="Monitor " Foreground="#E53935"/>
                    <Run Text="Zamówień" Foreground="#1B9A2F"/>
                </TextBlock>

                <Grid Margin="0 8 0 18" Height="6" Width="420" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Fill="#19A93A" RadiusX="3" RadiusY="3"/>
                    <Rectangle Grid.Column="1" Fill="#E0E0E0" RadiusX="3" RadiusY="3"/>
                    <Rectangle Grid.Column="2" Fill="#E53935" RadiusX="3" RadiusY="3"/>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Kafelkowy system kuchni: ToDo → InProgress → Ready" Foreground="#333333" FontSize="16"/>
                    <Button Content="Odśwież" Command="{Binding LoadOrdersCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="24 0 0 0"/>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ColumnCardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ToDo" FontSize="28" FontWeight="Bold" Foreground="#E53935" Margin="0 0 0 12"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding TodoItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAFA" CornerRadius="18" Padding="14" Margin="0 0 0 12" BorderBrush="#EEEEEE" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DishName}" FontSize="20" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding QuantityText}" FontSize="15" Foreground="#333333"/>
                                                <TextBlock Text="{Binding TableText}" FontSize="14" Foreground="#555555"/>
                                                <TextBlock Text="{Binding WaitingText}" FontSize="14" FontWeight="SemiBold" Foreground="#E53935" Margin="0 8 0 0"/>
                                                <TextBlock Text="{Binding Note}" FontSize="13" Foreground="#777777" TextWrapping="Wrap" Margin="0 4 0 10"/>
                                                <Button Content="Start" Command="{Binding DataContext.StartItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ColumnCardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="InProgress" FontSize="28" FontWeight="Bold" Foreground="#1B9A2F" Margin="0 0 0 12"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding InProgressItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAFA" CornerRadius="18" Padding="14" Margin="0 0 0 12" BorderBrush="#EEEEEE" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DishName}" FontSize="20" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding QuantityText}" FontSize="15" Foreground="#333333"/>
                                                <TextBlock Text="{Binding TableText}" FontSize="14" Foreground="#555555"/>
                                                <TextBlock Text="{Binding WaitingText}" FontSize="14" FontWeight="SemiBold" Foreground="#E53935" Margin="0 8 0 10"/>
                                                <Button Content="Ready" Command="{Binding DataContext.ReadyItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" Background="#E53935"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource ColumnCardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Ready" FontSize="28" FontWeight="Bold" Foreground="#333333" Margin="0 0 0 12"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReadyItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFAFA" CornerRadius="18" Padding="14" Margin="0 0 0 12" BorderBrush="#EEEEEE" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DishName}" FontSize="20" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding QuantityText}" FontSize="15" Foreground="#333333"/>
                                                <TextBlock Text="{Binding TableText}" FontSize="14" Foreground="#555555"/>
                                                <TextBlock Text="{Binding WaitingText}" FontSize="14" FontWeight="SemiBold" Foreground="#1B9A2F" Margin="0 8 0 0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
