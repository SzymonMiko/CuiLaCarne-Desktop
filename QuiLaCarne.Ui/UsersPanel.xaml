<Page
  x:Class="QuiLaCarne.Ui.UsersPanel"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="#F5F5F5">
  <Page.Resources>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#19A93A" />
      <Setter Property="Padding" Value="12 6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Background="#19A93A">
      <TextBlock Text="Qui la Carne" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="16 0" />
      <TextBlock Text="Klienci" DockPanel.Dock="Right" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0 0 16 0" />
    </DockPanel>

    <Grid Grid.Row="1" Margin="16" MinWidth="720">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="10" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock FontSize="28" FontWeight="Bold">
          <Run Text="Lista " Foreground="#E53935" />
          <Run Text="klientów" Foreground="#1B9A2F" />
        </TextBlock>
        <TextBlock Text="Zamówienia i zgłoszenia klientów z lokalnej zsynchronizowanej bazy." Foreground="#333333" FontSize="13" />
      </StackPanel>

      <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12">
        <Border.Effect>
          <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12" />
        </Border.Effect>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="360" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.35*" MinWidth="460" />
          </Grid.ColumnDefinitions>

          <DataGrid
            ItemsSource="{Binding Clients}"
            SelectedItem="{Binding SelectedClient}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            HeadersVisibility="Column"
            GridLinesVisibility="None"
            RowHeight="34"
            FontSize="13">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Użytkownik" Binding="{Binding Username}" Width="*" />
              <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.8*" />
              <DataGridCheckBoxColumn Header="Aktywny" Binding="{Binding IsEnabled}" Width="80" />
              <DataGridTextColumn Header="Role" Binding="{Binding RolesText}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

            <StackPanel>
              <TextBlock Text="{Binding SelectedClient.Username, StringFormat=Wybrany klient: {0}, TargetNullValue=Wybierz klienta}" FontWeight="Bold" FontSize="16" />
              <TextBlock Text="{Binding SelectedClient.Email}" Foreground="#555" FontSize="12" />
            </StackPanel>

            <Grid Grid.Row="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Zamówienia" FontWeight="Bold" FontSize="14" />
              <DataGrid
                Grid.Row="2"
                ItemsSource="{Binding ClientOrders}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                RowHeight="30"
                FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Czas" Binding="{Binding CreatedAtText}" Width="112" />
                  <DataGridTextColumn Header="Stolik" Binding="{Binding TableNumber}" Width="64" />
                  <DataGridTextColumn Header="Status" Binding="{Binding StatusesText}" Width="90" />
                  <DataGridTextColumn Header="Dania" Binding="{Binding DishesText}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>

            <Grid Grid.Row="3">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Rezerwacje" FontWeight="Bold" FontSize="14" />
              <DataGrid
                Grid.Row="2"
                ItemsSource="{Binding ClientReservations}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                RowHeight="30"
                FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Od" Binding="{Binding ReservedFromText}" Width="112" />
                  <DataGridTextColumn Header="Do" Binding="{Binding ReservedUntilText}" Width="112" />
                  <DataGridTextColumn Header="Stolik" Binding="{Binding TableNumber}" Width="64" />
                  <DataGridTextColumn Header="Status" Binding="{Binding StatusesText}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>

            <Grid Grid.Row="4">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Zgłoszenia" FontWeight="Bold" FontSize="14" />
              <DataGrid
                Grid.Row="2"
                ItemsSource="{Binding ClientReports}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="None"
                RowHeight="30"
                FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Czas" Binding="{Binding CreatedAtText}" Width="112" />
                  <DataGridTextColumn Header="Zgłaszający" Binding="{Binding Reporter}" Width="90" />
                  <DataGridTextColumn Header="Status" Binding="{Binding StatusesText}" Width="90" />
                  <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
